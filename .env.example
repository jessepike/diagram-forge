# Diagram Forge — environment configuration
#
# Copy this file to `.env` and fill in your API keys. The server loads .env
# automatically at startup (see src/diagram_forge/__init__.py). Variables
# already set in your shell take precedence — load_dotenv runs with
# override=False.
#
# .env is gitignored. Never commit real keys.

# OpenAI API key — used for gpt-image-2, gpt-image-1.5, gpt-image-1-mini
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API key — used for gemini-3-pro-image, gemini-3.1-flash-image
# Get one at https://ai.google.dev/ (paid tier required for image generation)
GEMINI_API_KEY=
